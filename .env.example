# Neon Postgres connection string.
# On Vercel: Storage tab -> Create Database -> Postgres (powered by Neon) -> Connect to Project.
# This env var is added automatically once you connect the database to your project.
DATABASE_URL=

# Vercel Blob token for image uploads.
# On Vercel: Storage tab -> Create Database -> Blob -> Connect to Project.
# Added automatically once you connect the store to your project.
BLOB_READ_WRITE_TOKEN=

# The password you will type on /admin/login to edit the site.
# Set this yourself in Vercel -> Project -> Settings -> Environment Variables.
ADMIN_PASSWORD=change-this-password

# Any long random string, used to sign the admin login session cookie.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string
