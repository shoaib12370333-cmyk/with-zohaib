# ───────── Required ─────────

# Neon Postgres connection string.
# Vercel: Storage tab -> Create Database -> Postgres (Neon) -> Connect to Project.
DATABASE_URL=

# Password you type on /admin/login.
ADMIN_PASSWORD=change-this-password

# Long random string used to sign the admin session cookie (REQUIRED in production).
# Generate: openssl rand -base64 32
SESSION_SECRET=change-this-to-a-long-random-string

# ───────── Recommended ─────────

# Vercel Blob token for image uploads (added automatically when you connect Blob).
BLOB_READ_WRITE_TOKEN=

# Public URL of the site (used for sitemap, canonical links, share cards).
SITE_URL=https://ecommercewithzohaib.com

# ───────── Optional upgrades ─────────

# Two-factor login for /admin. Base32 secret — add it to Google Authenticator / Authy
# (account name anything, "time based"). Generate one at /admin/security once logged in.
ADMIN_TOTP_SECRET=

# Email yourself every new lead (https://resend.com — free tier is plenty).
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=Website <onboarding@resend.dev>

# Or push every new lead to Slack / Discord / any webhook that accepts {"text": "..."}.
NOTIFY_WEBHOOK_URL=
